{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  // The following run indiserver with INDI Mount, Camera, and Focuser simulator
  // The first driver is the one that can be debugged, in this case the indi_simulator_telescope driver.
  //
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Attach indi_alpaca_server",
      "type": "cppdbg",
      "request": "attach",
      "program": "/home/damiano/indi/build/indi-build/drivers/alpaca/indi_alpaca_server",
      "MIMode": "gdb",
      "setupCommands": [
          {
              "description": "Enable pretty-printing for gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
          {
              "description": "Set Disassembly Flavor to Intel",
              "text": "-gdb-set disassembly-flavor intel",
              "ignoreFailures": true
          }
      ]
    }   
  ]
}
